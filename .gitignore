# ─── Entorno y credenciales ───────────────────────────────────
.env
.env.*
!.env.example
*.env

# ─── Logs ─────────────────────────────────────────────────────
logs/
*.log

# ─── Caché y temporales ───────────────────────────────────────
cache/
tmp/
temp/

# ─── Dependencias ─────────────────────────────────────────────
vendor/
node_modules/

# ─── Fuente de DashboardKit (assets ya copiados a public/assets) ──
dashboardkit-src/

# ─── Herramientas de desarrollo local ─────────────────────────
.claude/
.codex/
.vscode/
.idea/

# ─── Sistema operativo ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Comprimidos y backups ────────────────────────────────────
*.zip
*.rar
*.7z
*.tar.gz
*.bak
*.sql.bak
*.backup

# ─── PHP ──────────────────────────────────────────────────────
*.phar

# ─── Uploads de usuarios (no versionar imágenes reales) ──────
public/uploads/profiles/*
!public/uploads/profiles/.gitkeep
public/uploads/manuals/*
!public/uploads/manuals/.gitkeep

# NOTA: database/db_skeleton.sql SÍ se incluye en el repo
# porque contiene solo la estructura base (sin datos reales sensibles).
