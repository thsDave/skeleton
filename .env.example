# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo como .env y ajusta los valores a tu entorno local.
# NUNCA subas el archivo .env al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Aplicación ──────────────────────────────────────────────────────────────
APP_NAME="Skeleton"
APP_URL="http://localhost/template/public"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE="America/El_Salvador"

# ─── Base de datos ───────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_skeleton
DB_USERNAME=root
DB_PASSWORD=

# ─── Sesión ──────────────────────────────────────────────────────────────────
# Tiempo de vida de la sesión en segundos (1800 = 30 minutos)
SESSION_LIFETIME=1800

# ─── Logs ────────────────────────────────────────────────────────────────────
# Ruta relativa al directorio raíz del proyecto
LOG_PATH="logs/error.log"
