# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo como .env y ajusta los valores a tu entorno local.
# NUNCA subas el archivo .env al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Aplicación ──────────────────────────────────────────────────────────────
APP_NAME="Skeleton"
APP_URL="http://localhost/template/public"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE="America/El_Salvador"

# ─── Base de datos ───────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_skeleton
DB_USERNAME=root
DB_PASSWORD=

# ─── Sesión ──────────────────────────────────────────────────────────────────
# Tiempo de vida de la sesión en segundos (1800 = 30 minutos)
SESSION_LIFETIME=1800

# ─── Logs ────────────────────────────────────────────────────────────────────
# Ruta relativa al directorio raíz del proyecto
LOG_PATH="logs/error.log"

# ─── Correo electrónico (SMTP) ────────────────────────────────────────────────
# MAIL_ENCRYPTION: tls (STARTTLS, puerto 587), ssl (puerto 465), vacío (sin cifrado)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Skeleton"

# ─── Recuperación de contraseña ──────────────────────────────────────────────
# Minutos de validez del enlace de recuperación
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=60
# Máximo de solicitudes por correo en el período definido
PASSWORD_RESET_MAX_REQUESTS=3
# Período de rate limit en minutos
PASSWORD_RESET_RATE_LIMIT_MINUTES=15
