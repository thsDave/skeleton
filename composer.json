{
    "name": "skeleton/php-mvc-template",
    "description": "Plantilla base MVC en PHP 8.3 para sistemas administrativos",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "bacon/bacon-qr-code": "^3.1",
        "phpmailer/phpmailer": "^7.0",
        "pragmarx/google2fa": "^9.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
